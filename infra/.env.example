# ─────────────────────────────────────────────────────────────────────────────
# Переезд на свой сервер. Скопировать в .env НА СЕРВЕРЕ и заполнить.
# Этот файл — образец, в нём не должно быть ни одного настоящего пароля.
# ─────────────────────────────────────────────────────────────────────────────

# ── Домены ───────────────────────────────────────────────────────────────────
# Сайт остаётся на Vercel, на сервер переезжает всё остальное.
SITE_URL=https://aiservicemarket.com
API_EXTERNAL_URL=https://auth.aiservicemarket.com
SUPABASE_PUBLIC_URL=https://auth.aiservicemarket.com

# Куда разрешено возвращать человека после входа. Без этого списка ссылка из
# письма ведёт в ошибку — частая причина «вход не работает» после переезда.
ADDITIONAL_REDIRECT_URLS=https://aiservicemarket.com/auth/callback,https://www.aiservicemarket.com/auth/callback

# ── Секреты (сгенерировать на сервере, НЕ придумывать руками) ─────────────────
# openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
# Выдаются генератором Supabase вместе с JWT_SECRET
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Вход в панель Supabase Studio (наружу не открываем, только через SSH-туннель)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ── Почта ────────────────────────────────────────────────────────────────────
# ВАЖНО: в стандартной сборке стоит ловушка писем Inbucket — письма никуда не
# уходят, а выглядит как будто всё работает. Обязательно заполнить настоящий SMTP.
# Для РФ+мира: Unisender Go или SendPulse — они доходят до Mail.ru и Яндекс.Почты
# лучше западных. В DNS обязательно SPF, DKIM и DMARC, иначе письма уйдут в спам.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=AI Marketplace
SMTP_ADMIN_EMAIL=noreply@aiservicemarket.com
# По умолчанию лимит очень низкий — человек не получит второе письмо.
GOTRUE_RATE_LIMIT_EMAIL_SENT=100

# ── Вход через Google (переносим существующий, чтобы люди не потеряли доступ) ─
# Взять ТОТ ЖЕ Client ID, что настроен сейчас в Supabase Cloud, и добавить в
# Google Console новый адрес возврата: https://auth.aiservicemarket.com/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://auth.aiservicemarket.com/auth/v1/callback

# ── Вход через Яндекс (и позже VK) — идёт через Keycloak ──────────────────────
# Своего провайдера «Яндекс» у Supabase нет и не будет: список провайдеров в
# самостоятельной сборке жёстко зашит. Поэтому рядом ставится Keycloak с
# плагином русских провайдеров, а Supabase видит его как один вход.
GOTRUE_EXTERNAL_KEYCLOAK_ENABLED=true
GOTRUE_EXTERNAL_KEYCLOAK_CLIENT_ID=ai-marketplace
GOTRUE_EXTERNAL_KEYCLOAK_SECRET=
GOTRUE_EXTERNAL_KEYCLOAK_URL=https://id.aiservicemarket.com/realms/aimarketplace
GOTRUE_EXTERNAL_KEYCLOAK_REDIRECT_URI=https://auth.aiservicemarket.com/auth/v1/callback

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_HOSTNAME=id.aiservicemarket.com
# Ключи приложения в Яндекс OAuth: https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ── Наш сервер приложений (переезжает с Render) ───────────────────────────────
API_PUBLIC_URL=https://api.aiservicemarket.com
CLIENT_URL=https://aiservicemarket.com
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/postgres
DIRECT_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/postgres
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SECRET_KEY}
